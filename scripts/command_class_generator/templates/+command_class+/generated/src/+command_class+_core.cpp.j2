    // Triggers the Attribute Resolver by creating a desired/reported mismatch on the group node.
    // Uses attribute_resolver_start_group_resolution which holds resolver_mutex across the
    // entire check-and-act to prevent a TOCTOU race with the resolver thread.
    void {{command_class_name_lower}}_core::start_group_resolution(attribute_store::attribute group_node, group_resolution_options options)
    {
        attribute_resolver_start_group_resolution(group_node, options);
    }

    // Stops the resolution by setting the reported value, which makes desired and reported both
    // defined and "matched" from the resolver's perspective. Typically called from report handlers
    // after a successful GET response is received and parsed. Not needed for SET rules, as the
    // resolver automatically cleans up after the SET frame is transmitted.
    void {{command_class_name_lower}}_core::stop_group_resolution(attribute_store::attribute group_node)
    {
        group_node.set_reported<uint8_t>(0);
    }

    void {{command_class_name_lower}}_core::mqtt_publish_report(attribute_store::attribute endpoint_node,
                                                                {{command_class_name_lower}}_commands_t command_id,
                                                                {{command_class_name_lower}}_attribute_map_t attribute_map)
    {
        nlohmann::json j_map = nlohmann::json::object();
        std::string command_topic;

        switch (command_id) {
            {% for command in command_class.commands %}
                {% if utils.should_mqtt_publish_report(command) == "True" %}
                    case {{command_class_name_lower}}_commands_t::{{command_class.name | upper}}_{{command.name | upper}}:
                        command_topic = "{{utils.convert_command_name_to_mqtt_topic_token(command.name)}}";
                        {{ utils.mqtt_publish_json_from_attribute_map(command_class_name_lower, command) }}
                    break;
                {% endif %}
            {% endfor %}
            default:
                return;
        }

        auto json_str = j_map.dump();

        std::string base_topic = zpc_mqtt::utils::get_base_topic_from_attribute(endpoint_node);

        std::string topic = fmt::format("{}{}/{}/{}",
                                        base_topic,
                                        zwave_command_class::zwave_command_class_base::mqtt_command_class_namespace,
                                        "Report",
                                        command_topic);

        zpc_mqtt::publish_report(topic.c_str(), json_str.c_str(), json_str.size());
    }

