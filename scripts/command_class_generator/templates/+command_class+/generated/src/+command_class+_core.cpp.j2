    {{command_class_name_lower}}_core::{{command_class_name_lower}}_core() : zwave_command_class_base({{command_class_name_lower}}_core::cc_properties, attributes, "{{utils.convert_command_name_to_mqtt_topic_token(command_class.name.replace("COMMAND_CLASS_", ""))}}") 
    {
        {% for command in command_class.commands %}
            {% if utils.is_rx(command) == "True" %}
                attribute_resolver::register_rules(static_cast<attribute_store_type_t>({{command.name | lower }}_group_attributes_t::{{command.name | upper }}_GROUP),
                // Set rule
                {% if utils.is_set(command.name) == "True" %}
                    [this](attribute_store_node_t node, uint8_t *data, uint16_t *length) {
                        try {sl_log_debug(LOG_TAG.data(), "{{command.name }}_GROUP requested");
                            auto command = static_cast<uint8_t>({{command_class_name_lower}}_commands_t::{{command_class.name | upper}}_{{command.name | upper | replace("_GROUP", "")}});
                            m_frame_generator.initialize_frame(command, data, length);
                            set_requested_args args = {node, &m_frame_generator};
                            return this->on_{{command.name | lower | replace("_GROUP", "")}}_requested(args, data, length);
                        } catch (const std::exception &e) {
                            sl_log_error(LOG_TAG.data(), "Error while generating {{ command.name }}_GROUP : %s", e.what());
                            return SL_STATUS_FAIL;
                        }
                    },
                {% else %}
                    nullptr,
                {% endif %}
                // Get rule
                {% if utils.is_get(command.name) == "True" %}
                    [this](attribute_store_node_t node, uint8_t *data, uint16_t *length) {
                    try {sl_log_debug(LOG_TAG.data(), "{{command.name }}_GROUP requested");
                        auto command = static_cast<uint8_t>({{command_class_name_lower}}_commands_t::{{command_class.name | upper}}_{{command.name | upper }});
                        m_frame_generator.initialize_frame(command, data, length);
                        get_requested_args args = {node, &m_frame_generator};
                        return this->on_{{command.name | lower | replace("_GROUP", "")}}_requested(args, data, length);
                    } catch (const std::exception &e) {
                        sl_log_error(LOG_TAG.data(), "Error while generating {{command.name }}_GROUP : %s", e.what());
                        return SL_STATUS_FAIL;
                    }}
                {% else %}
                    nullptr
                {% endif %}
                );
            {% endif +%}
        {% endfor %}

        // Interview is now handled via COMPONENT_CONNECTOR_INTERVIEW_DONE event
        // Command classes should implement on_interview() to handle interview logic
    }

    {% if command_class.control == true %}
    sl_status_t {{command_class_name_lower}}_core::control_handler(const zwave_controller_connection_info_t *connection_info,
                                                                    const uint8_t *frame_data,
                                                                    [[maybe_unused]] uint16_t frame_length)
    {
        // Setup
        attribute_store::attribute endpoint_node(command_class_utils::get_endpoint_node(connection_info));
        // Create parser
        zwave_frame_parser parser(frame_data, frame_length);
        // Store frame name in here to be able to log it in case of error
        std::string debug_frame_name;
        // Report args struct (unused when this CC defines no TX/report commands handled in control_handler)
        [[maybe_unused]] const report_received_args report_args = {endpoint_node, parser, connection_info};

        // We encapsulate the switch in a try catch to logs errors
        // This avoids to have to catch exceptions in each command handler
        try {
        switch (frame_data[COMMAND_INDEX]) {
            {% for command in command_class.commands %}
                {% if utils.is_tx(command) == "True" %}
                case static_cast<uint8_t>({{command_class_name_lower}}_commands_t::{{command_class.name | upper}}_{{command.name | upper}}):
                    debug_frame_name = "{{command.name}}";
                    return on_{{command.name | lower}}_received(report_args);
                {% endif %}
            {% endfor %}
            default:
                return SL_STATUS_NOT_SUPPORTED;
        }
        sl_log_debug(LOG_TAG.data(), "%s frame received", debug_frame_name.c_str());
        } catch (const std::exception &e) {
        sl_log_error(LOG_TAG.data(), "Error while parsing %s frame : %s", debug_frame_name.c_str(), e.what());
        return SL_STATUS_FAIL;
        }
        return SL_STATUS_OK;
    }
    {% endif %}

    {% if command_class.support == true %}
    sl_status_t {{command_class_name_lower}}_core::support_handler(const zwave_controller_connection_info_t *connection_info,
                                                                    const uint8_t *frame_data,
                                                                    [[maybe_unused]] uint16_t frame_length)
    {
            // Setup
        attribute_store::attribute endpoint_node(command_class_utils::get_endpoint_node(connection_info));
        // Create parser
        zwave_frame_parser parser(frame_data, frame_length);
        // Store frame name in here to be able to log it in case of error
        std::string debug_frame_name;

        // We encapsulate the switch in a try catch to logs errors
        // This avoids to have to catch exceptions in each command handler
        try {
        switch (frame_data[COMMAND_INDEX]) {
            {% for command in command_class.commands %}
                {% if utils.is_get(command.name) == "True" %}
                    case static_cast<uint8_t>({{command_class_name_lower}}_commands_t::{{command_class.name | upper}}_{{command.name | upper}}):
                    {
                        debug_frame_name = "{{command.name}}";
                        // Parse the incoming GET frame
                        const get_received_args get_args = {endpoint_node, parser, nullptr, connection_info};
                        {{command_class_name_lower}}_attribute_map_t attribute_map = on_{{command.name | lower}}_received(get_args);

                        // Delegate full handling to the parsed hook.
                        // The base implementation calls on_{{command.name | lower}}_support_requested_assemble_frame and sends the report.
                        // Override on_{{command.name | lower}}_parsed in a derived class to replace this behaviour entirely.
                        return on_{{command.name | lower}}_parsed(connection_info, endpoint_node, attribute_map);
                    }
                {% endif %}
                {% if utils.is_set(command.name) == "True" %}
                    case static_cast<uint8_t>({{command_class_name_lower}}_commands_t::{{command_class.name | upper}}_{{command.name | upper}}):
                    {
                        debug_frame_name = "{{command.name}}";
                        zwave_frame_parser received_set_frame(frame_data, frame_length);

                        // Handle get command
                        const set_received_args set_args = {endpoint_node, received_set_frame};
                        {{command_class_name_lower}}_attribute_map_t attribute_map = on_{{command.name | lower}}_received(set_args);

                        return on_{{command.name | lower}}_support_received(connection_info, attribute_map);
                    }
                {% endif %}
            {% endfor %}

            default:
                return SL_STATUS_NOT_SUPPORTED;
        }
        sl_log_debug(LOG_TAG.data(), "%s frame received", debug_frame_name.c_str());
        } catch (const std::exception &e) {
        sl_log_error(LOG_TAG.data(), "Error while parsing %s frame : %s", debug_frame_name.c_str(), e.what());
        return SL_STATUS_FAIL;
        }
        return SL_STATUS_OK;
    }
    {% endif %}


