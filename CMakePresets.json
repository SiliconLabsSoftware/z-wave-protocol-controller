{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 25,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "zpc",
      "hidden": true,
      "binaryDir": "${sourceDir}/build/${presetName}",
      "generator": "Ninja",
      "cacheVariables": {
        "CMAKE_VERBOSE_MAKEFILE": "OFF",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "1"
      }
    },
    {
      "name": "macos",
      "inherits": ["zpc"]
    },
    {
      "name": "debian",
      "inherits": ["zpc"],
      "cacheVariables": {
        "CMAKE_INSTALL_PREFIX": "$penv{CMAKE_INSTALL_PREFIX}"
      }
    },
    {
      "name": "unit-test",
      "inherits": ["zpc"],
      "cacheVariables": {
        "UNIT_TEST": "ON",
        "CMAKE_BUILD_TYPE": "Debug",
        "ZPC_ENABLE_SANITIZERS": "ON"
      }
    },
    {
      "name": "unit-test-release",
      "inherits": ["unit-test"],
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    }
  ],
  "testPresets": [
    {
      "name": "unit-test",
      "configurePreset": "unit-test",
      "output": {
        "outputOnFailure": true,
        "outputJUnitFile": "test-results.xml"
      },
      "execution": {
        "environment": {
          "ASAN_OPTIONS": "detect_leaks=1:abort_on_error=1:halt_on_error=1",
          "UBSAN_OPTIONS": "halt_on_error=1:print_stacktrace=1"
        }
      }
    },
    {
      "name": "unit-test-release",
      "configurePreset": "unit-test-release",
      "output": {
        "outputOnFailure": true,
        "outputJUnitFile": "test-results-release.xml"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "macos",
      "configurePreset": "macos",
      "hidden": false,
      "jobs": 8
    },
    {
      "name": "debian",
      "configurePreset": "debian",
      "hidden": false,
      "jobs": 8
    },
    {
      "name": "unit-test",
      "configurePreset": "unit-test",
      "targets": ["UNIT_TEST"],
      "jobs": 8
    },
    {
      "name": "unit-test-release",
      "configurePreset": "unit-test-release",
      "targets": ["UNIT_TEST"],
      "jobs": 8
    }
  ],
  "packagePresets": [
    {
      "name": "debian",
      "configurePreset": "debian"
    }
  ],
  "workflowPresets": [
    {
      "name": "macos",
      "steps": [
        { "type": "configure", "name": "macos" },
        { "type": "build", "name": "macos" }
      ]
    },
    {
      "name": "debian",
      "steps": [
        { "type": "configure", "name": "debian" },
        { "type": "build", "name": "debian" },
        { "type": "package", "name": "debian" }
      ]
    },
    {
      "name": "unit-test",
      "steps": [
        { "type": "configure", "name": "unit-test" },
        { "type": "build", "name": "unit-test" },
        { "type": "test", "name": "unit-test" }
      ]
    },
    {
      "name": "unit-test-release",
      "steps": [
        { "type": "configure", "name": "unit-test-release" },
        { "type": "build", "name": "unit-test-release" },
        { "type": "test", "name": "unit-test-release" }
      ]
    }
  ]
}
