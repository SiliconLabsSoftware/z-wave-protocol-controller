#ifndef COMMAND_CLASS_INDICATOR_ATTRIBUTES_H
#define COMMAND_CLASS_INDICATOR_ATTRIBUTES_H

#include "attribute_store.h"

namespace zwave_command_class
{
    // Manual attribute types for supported-indicator ID list (offset from this component's
    // COMPONENT_ATTRIBUTE_BASE to avoid overlapping generated indicator_* attribute enums).
    enum indicator_supported_indicator_store_attributes_t : attribute_store_type_t {
        SUPPORTED_INDICATORS_GROUP = @COMPONENT_ATTRIBUTE_BASE@,
        supported_indicators,
        finished_indicators,
        interview_finished,
    };
}  // namespace zwave_command_class

#endif  // COMMAND_CLASS_INDICATOR_ATTRIBUTES_H
