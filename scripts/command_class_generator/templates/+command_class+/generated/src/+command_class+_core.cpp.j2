        {% elif utils.is_get(command.name) == "True" and command_class.support == true %}
            sl_status_t {{command_class_name_lower}}_core::on_{{command.name | lower}}_parsed(const zwave_controller_connection_info_t *connection_info, attribute_store::attribute endpoint, {{command_class_name_lower}}_attribute_map_t payload) {
                zwave_frame_generator_standalone report_frame;
                report_frame.add_header(properties.command_class_id, static_cast<uint8_t>({{command_class_name_lower}}_commands_t::{{command_class.name | upper}}_{{command.name | upper | replace("_GET", "_REPORT") | replace("_MESSAGE_ENCAPSULATION", "")}}));
                std::vector<uint8_t> frame;
                on_{{command.name | lower}}_support_requested_assemble_frame(connection_info, payload, report_frame, frame);
                return command_class_utils::send_report(connection_info, static_cast<uint16_t>(frame.size()), frame.data());
            }
