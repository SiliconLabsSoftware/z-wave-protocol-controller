    const attribute_list_registration_t attributes = { 
        //////////////////////////////////////////////////////////////////////
        // {{command_class_name_lower}}_attributes
        //////////////////////////////////////////////////////////////////////
        { static_cast<attribute_store_type_t>({{command_class_name_lower}}_attributes_t::supported_version), "{{command_class_name_lower}} version", ATTRIBUTE_ENDPOINT_ID, U8_STORAGE_TYPE }, 

        {% set group_name = namespace(value="") %}
